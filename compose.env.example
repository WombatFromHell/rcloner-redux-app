VERSION="v1.0.5"
IMAGENAME="rcloner-redux"
TZ="UTC"
#
# Container healthcheck: the container is marked unhealthy if any sync's
# .healthcheck file is degraded or older than HEALTH_MAX_AGE seconds (stale =
# sync silently stopped). Default 7200 (2h); raise for crons slower than the
# default 15-minute schedule.
# HEALTH_MAX_AGE=7200
#
# Host-side paths (used by build.sh / compose.yml for mounts)
APPROOT=""
SYNCTARGET=""
#
# One OS account + crontab is created per user. USERS may be set explicitly
# (space-separated) or left empty to infer the user list from any <USER>_PUID /
# <USER>_PGID env vars below. Each user must have a unique PUID/PGID and an
# env-safe name (letters, digits, underscore only).
# Per-user per-remote rclone secrets live in files named <user>-<remote> under
# ./secrets/ (mounted read-only at /run/secrets), e.g. secrets/bob-gdrive; the
# filename suffix IS the rclone remote name. See secrets/*.example.
USERS=""
#
# ===== per-user settings (duplicate this block per user) =====
# Example for a user named "alice". Replace "ALICE" with the uppercased
# username wherever it appears below.
#
# Account uid/gid that the sync job runs as (matches the host's uid/gid)
# ALICE_PUID=1000
# ALICE_PGID=1000
#
# Cron schedule for this user (applied at container start; restart to change).
# Per-remote override: add CRON="..." inside a secrets file
# (./secrets/alice-gdrive) to use a different schedule for that remote.
# Disable one remote without deleting its file: ENABLED=0 in that secrets file.
# ALICE_CRON="*/15 * * * *"
#
# Optional per-user rclone filter file (default: /app/rclone/filters-alice)
# ALICE_FILTER_FILE=/app/rclone/filters-alice
#
# NOTE: rclone secrets (TYPE/CLIENT_ID/CLIENT_SECRET/TOKEN/SCOPE), the user's
# SRC_DIR/TGT_DIR, and per-remote RCLONE_OPTS now go in the per-remote secret
# file (./secrets/<user>-<remote>), not here — so they never appear in
# `docker inspect`. For the plain `docker run` dev flow (build.sh) the matching
# vars can still be provided here:
#   ALICE_SRC_DIR=/synctarget/alice
#   ALICE_TGT_DIR=alice:/Backups
#   RCLONE_CONFIG_ALICE_TYPE=drive
#   RCLONE_CONFIG_ALICE_CLIENT_ID=...
#   RCLONE_CONFIG_ALICE_CLIENT_SECRET=...
#   RCLONE_CONFIG_ALICE_TOKEN=...
